# jero 환경변수 예시 — 실제 값은 .env.local 에 넣고 절대 커밋하지 않는다.
# NEXT_PUBLIC_ 접두는 "클라이언트에 노출돼도 되는 값"에만 사용한다(서버 시크릿에 붙이지 말 것).

# Google Maps (클라이언트 노출 전제 — 콘솔에서 HTTP referrer + API 범위 제한을 건다)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (선택) — AdvancedMarkerElement 사용 시 필요. 없으면 OverlayView 폴백으로 동작.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Supabase (백엔드 확정 시 사용)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # 서버 전용 — 절대 NEXT_PUBLIC_ 금지

# AI 어시스턴트 (18) — 전부 서버 전용. 없으면 기능이 비활성되고 기존 화면은 그대로 동작한다.
# Gemini 키: https://aistudio.google.com (무료 티어). 채팅·임베딩 공용.
# GOOGLE_GENERATIVE_AI_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001   # 교체 시 전체 재인덱싱 필요(768차원 고정)
# AI_MODEL=gemini-flash-latest           # 채팅 모델(별칭 권장 — 고정 버전은 조기 종료될 수 있음)
# ASSISTANT_DAILY_LIMIT=30               # 사용자당 일일 요청 한도
# ASSISTANT_ENABLED=false                # 키가 있어도 강제로 끄고 싶을 때만

# Places grounding(장소 추천) — 없으면 어시스턴트는 텍스트로만 답한다(카드 없음).
# ★ 위 NEXT_PUBLIC_GOOGLE_MAPS_API_KEY 와 **별도 키**를 발급한다.
#   클라 키는 HTTP referrer 제한이 걸려 있어 서버에서 호출하면 거부된다.
#   서버 키는 노출되지 않으므로 referrer 대신 "API 제한 = Places API" 로 잠근다.
# GOOGLE_PLACES_SERVER_KEY=
